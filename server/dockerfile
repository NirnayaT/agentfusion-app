# Use the official Python image (3.13-slim for minimal footprint)
FROM python:3.13-slim

# Install system dependencies and utilities
RUN apt-get update && apt-get install -y \
    build-essential \
    netcat-traditional \
    postgresql-client \
    curl \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

# Install uv (Python package manager)
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"

# Set working directory
WORKDIR /code

# Copy the entire project
COPY . ./

# Fix potential CRLF line endings and ensure script is executable

# Setup Python environment using uv
ENV PATH="/code/.venv/bin:$PATH"
ENV UV_PROJECT_ENVIRONMENT="/.venv"
ENV UV_LINK_MODE=copy

RUN uv venv && uv sync

# Expose any ports (optional, for debugging or running directly)
EXPOSE 8000 8025

# Run the startup script
ENTRYPOINT ["/code/entrypoint.sh"]
